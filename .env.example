# Supabase project URL and publishable key (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only key used to send Supabase Auth admin invitation emails.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Set this to the deployed application origin for email confirmation redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
