# Copy to .env.local and adjust. Never commit .env.local.

# --- Local development (Firebase Emulator Suite) ---
# "demo-" project ids never touch real Firebase services.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-vectora
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-vectora.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-vectora.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# --- Production only (server-side Admin SDK service account) ---
# Leave empty when using the emulators. On Firebase App Hosting / Cloud Run,
# Application Default Credentials are used automatically and these can stay empty.
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# Session cookie lifetime in days (Firebase allows 5 minutes to 14 days).
SESSION_EXPIRES_DAYS=5
