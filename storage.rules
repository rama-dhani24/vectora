rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
    }
    function isImageUnder5MB() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Transaction proofs: proofs/{challengeId}/{fileName}
    match /proofs/{challengeId}/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isImageUnder5MB();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
